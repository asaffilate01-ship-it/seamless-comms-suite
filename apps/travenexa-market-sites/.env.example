# Server-side only. Do not use VITE_ to expose credentials to browsers.
# The TraveNexa landlord core is in services/travenexa-core; deploy it separately.
# TRAVENEXA_API_ORIGIN is the HTTPS origin of that core.
# TRAVENEXA_SERVER_TOKEN must match this exact market tenant's secret in
# core TRAVENEXA_TENANT_TOKENS_JSON. API integration does NOT activate suppliers.
TRAVENEXA_API_ORIGIN=
TRAVENEXA_SERVER_TOKEN=
# In separate live deployments, restrict the host to a single intended source market: kr | jp | cn | us
SITE_MARKET=
PORT=4301
