# Process environment reference. The standard-library app does not auto-load .env.
KNOWLEDGE_PROVIDER=evidence
KNOWLEDGE_STORAGE=sqlite
KNOWLEDGE_DB=var/knowledge.db
KNOWLEDGE_CREDENTIALS=var/credentials.json
KNOWLEDGE_MODEL_URL=http://127.0.0.1:11434
# Set exact locally installed model identifiers when enabling Ollama.
KNOWLEDGE_CHAT_MODEL=
KNOWLEDGE_EMBED_MODEL=

# Optional Neo4j backend, configured only on the shared Python service.
# Use neo4j+s:// for a remote Aura database.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
NEO4J_PASSWORD=
