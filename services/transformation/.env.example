# Generate an independent random signing key. Set the SAME key on the trusted host.
# Never use a VITE_ prefix or put a service key in browser code.
TRANSFORMATION_SIGNING_KEY=
TRANSFORMATION_DB=var/transformation.db
KNOWLEDGE_STORAGE=sqlite
KNOWLEDGE_DB=var/knowledge.db
KNOWLEDGE_PROVIDER=evidence
# Optional operator-hosted generation and embedding models; select installed versions.
KNOWLEDGE_MODEL_URL=http://127.0.0.1:11434
KNOWLEDGE_CHAT_MODEL=
KNOWLEDGE_EMBED_MODEL=
# Set KNOWLEDGE_STORAGE=neo4j after installing driver and initialising schema.
NEO4J_URI=neo4j+s://your-approved-neo4j-host
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Hosted business data requires this dedicated, non-superuser PostgreSQL login.
TRANSFORMATION_DATABASE_URL=
# Local evaluation only: opt in explicitly. Never use for a hosted multi-tenant launch.
BUSINESS360_ALLOW_SQLITE=0
# Omniqora host only: comma-separated tenant UUIDs entitled to the add-on.
BUSINESS360_ENABLED_TENANTS=

# Optional multi-provider agent hub. Operator-owned file; no browser-uploaded credentials.
# Copy ai-config.example.json outside the repository, replace placeholders and retain only approved entries.
OQ_AI_CONFIG=
# Set only the OQ_SECRET_* variables referenced by that private configuration, through your secret manager.
# Bedrock uses the AWS credential chain or an operator-selected profile.
