# Public browser configuration: use this project's existing Supabase settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Do not prefix these with VITE_.
TRANSFORMATION_URL=
TRANSFORMATION_SIGNING_KEY=
# Comma-separated tenant UUIDs. Empty means no tenants are enabled.
BUSINESS360_ENABLED_TENANTS=
# Map workspace UUID -> {"tenant":"tenant UUID","url":"https://service-host","token":"32+ character service token"}.
RRCI_BINDINGS_JSON={}
# Python service/database settings belong in the service's private environment;
# see services/transformation/.env.example and services/rrci/.env.example.

# Current portfolio gateway. All bindings default denied; no credentials in browser bundles.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OMNIQORA_BRIDGES_JSON=[]
# 32+ random server-only secret used by the SaaS Factory provisioning worker endpoint.
CONTROL_PLANE_WORKER_SECRET=
# Each binding references its own OQ_BRIDGE_* secret; see docs/ecosystem/bindings.example.json.

# Omniqora Connect / WhatsApp Cloud API
# Meta credentials are stored per number through the secured WhatsApp channel setup.
WHATSAPP_GRAPH_VERSION=v21.0

# Example source bridge secrets. Keep actual values in the deployment secret store.
OQ_BRIDGE_COURIER_BROKER=
OQ_BRIDGE_SPARESGRID_A=
OQ_BRIDGE_AUTOHASHI_A=
OQ_BRIDGE_ZIVVO_A=

# Omniqora Connect / verified Twilio inbound order lines (server only)
TWILIO_AUTH_TOKEN=

# Omniqora Geo / Franchise Territory Engine
GOOGLE_ROUTES_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# Haccora product adapters (server only)
OMNIQORA_PUBLIC_URL=
HACCORA_UK_FUNCTION_URL=
HACCORA_UK_APP_URL=https://app.haccora.co.uk
HACCORA_UK_PROVISIONING_SECRET=
HACCORA_UK_SYNC_SECRET=
HACCORA_DE_FUNCTION_URL=
HACCORA_DE_APP_URL=
HACCORA_DE_PROVISIONING_SECRET=
HACCORA_DE_SYNC_SECRET=


# AutoHashi / Omniqora Japanese auction inventory (server only)
# Configure one or both read providers. Never expose these through VITE_* variables.
THECARAPI_API_KEY=
CARSTACK_API_TOKEN=

# Signed AutoHashi -> Omniqora auction gateway.
# Use the same 32+ character secret in AutoHashi's OQ_BRIDGE_AUTOHASHI_A.
OQ_BRIDGE_AUTOHASHI_A=

# Future licensed Japan-side execution provider. Leave unset until the provider
# implements docs/automotive/JAPAN_AUCTION_AGENT_API_CONTRACT.md and passes staging.
AUTOHASHI_AUCTION_AGENT_URL=
AUTOHASHI_AUCTION_AGENT_TOKEN=
